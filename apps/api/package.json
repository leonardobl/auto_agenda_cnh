{
  "name": "@auto-agenda-cnh/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --env-file-if-exists=.env tests/*.test.ts",
    "test:update-snapshots": "node --test --test-update-snapshots --env-file-if-exists=.env tests/*.test.ts",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.ts",
    "db:up": "docker compose -f ../../infra/docker-compose.yml up -d",
    "db:down": "docker compose -f ../../infra/docker-compose.yml down"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.8.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
