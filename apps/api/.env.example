# Required — server refuses to start if any of these are missing.
NODE_ENV=development
PORT=3333
APP_ORIGIN=http://localhost:5173

# PostgreSQL connection string. This value works with infra/docker-compose.yml
# (docker compose -f infra/docker-compose.yml up -d); change it to use another server.
DATABASE_URL=postgresql://auto_agenda:auto_agenda@localhost:5432/auto_agenda
