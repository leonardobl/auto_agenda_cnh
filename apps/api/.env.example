# Required — server refuses to start if any of these are missing.
NODE_ENV=development
APP_ORIGIN=http://localhost:5173

# PostgreSQL connection string. This value works with infra/docker-compose.yml
# (docker compose -f infra/docker-compose.yml up -d); change it to use another server,
# e.g. a Supabase project's pooled connection string (Project Settings → Database →
# Connection string → "Transaction pooler", port 6543) for the hosted demo — set
# DATABASE_SSL=true below when pointing at Supabase or any other managed provider.
DATABASE_URL=postgresql://auto_agenda:auto_agenda@localhost:5432/auto_agenda

# Optional — overrides where the API listens locally (defaults to 3333). Hosts that
# assign their own port (Render) or don't use one at all (Vercel's serverless entry,
# api/index.ts) don't need this set.
# PORT=3333

# Optional — "true" for managed Postgres reached over the public internet (Supabase,
# Render, Neon, ...), which require TLS. Leave unset for the local Docker Postgres.
# DATABASE_SSL=true
