# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# environment variables (real secrets/tokens) — *.env.example files stay committed as documentation.
# Repo-wide safety net so no package's .env can slip in by accident; packages may also
# list these in their own .gitignore for local clarity (see e.g. apps/web/.gitignore).
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# local-only tooling (OpenSpec artifacts, Claude Code config)
/openspec
/.claude/*
# ...except team-shared, path-scoped conventions (see .claude/rules/)
!/.claude/rules/
!/.claude/rules/**
